# ============================================================
# HHGOA configuration — copy to .env and fill in what you have.
# NEVER commit a real .env. All values below are placeholders.
# The system runs in LOCAL SIMULATION mode when TigerGraph is unset.
# ============================================================

# --- TigerGraph (real graph backend) ---
# Leave empty → createBackend() selects the local degraded backend (honest, labelled).
TG_HOST=
TG_RESTPP_PORT=14240
TG_GSQL_PORT=14240
TG_GRAPH=hhgoa_fraud
TG_USERNAME=
TG_PASSWORD=
TG_TOKEN=
# Accepted aliases: TG_GRAPHNAME → TG_GRAPH, TG_API_TOKEN → TG_TOKEN
TG_GRAPHNAME=
TG_API_TOKEN=
# HHGOA_GRAPH_BACKEND = tigergraph | local   (default: tigergraph when TG_HOST+auth set, else local)
HHGOA_GRAPH_BACKEND=
HHGOA_ALLOW_LOCAL_FALLBACK=true
TG_TIMEOUT_MS=30000

# --- LLM provider (optional; deterministic reasoner is the default) ---
# LLM_PROVIDER: deterministic | anthropic | openai   (aliases: HHGOA_LLM_PROVIDER)
# With no key, the agent runs on the deterministic adapter and reports LLM=unavailable.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
HHGOA_LLM_PROVIDER=
HHGOA_LLM_MODEL=
HHGOA_LLM_BASE_URL=
HHGOA_LLM_MAX_TOKENS=2000
HHGOA_LLM_TEMPERATURE=0
# Legacy names also honored:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- TigerGraph MCP (official tigergraph/tigergraph-mcp) ---
# Example (local stdio server you installed yourself):
#   TIGERGRAPH_MCP_COMMAND=npx
#   TIGERGRAPH_MCP_ARGS=-y tigergraph-mcp
TIGERGRAPH_MCP_COMMAND=
TIGERGRAPH_MCP_ARGS=
TIGERGRAPH_MCP_URL=

# --- Document GraphRAG (local index; no external service required) ---
# DOCUMENT_RAG_PROVIDER: local-bm25 (default)
# DOCUMENT_RAG_PATH: optional extra markdown document to index (besides the dataset README)
DOCUMENT_RAG_PROVIDER=
DOCUMENT_RAG_PATH=

# --- Hosts ---
API_PORT=3000
API_HOST=127.0.0.1
API_BASE_PATH=
CORS_ORIGIN=
# MCP_NAMESPACE=hhgoa

# --- Overrides (rarely needed) ---
# HHGOA_DATA_DIR=
# HHGOA_MEMORY_DIR=
# HHGOA_OUTPUTS_DIR=
# HHGOA_MAX_STEPS=12
# HHGOA_MAX_EVIDENCE=30
